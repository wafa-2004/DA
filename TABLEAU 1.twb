      <aliases enabled='yes' />
      <column caption='Total sales measures' datatype='real' name='[Calculation_1249885844393985]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Sales])' />
      </column>
      <column caption='Sales after discount' datatype='real' name='[Calculation_1249885845479426]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Sales]) - sum([Discount]*([Sales]))' />
      </column>
      <column caption='Profit ratio' datatype='real' name='[Calculation_1249885847932931]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Profit])/sum([Sales])' />
      </column>
      <column caption='Profit per order' datatype='real' name='[Calculation_1249885850189828]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Profit])/COUNTD([Order ID])' />
      </column>
      <column caption='Sales per customer' datatype='real' name='[Calculation_1249885850935301]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Sales])/COUNTD([Customer ID])' />
      </column>
      <column caption='Total order by customer' datatype='integer' name='[Calculation_1249885851738118]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Order ID])' />
      </column>
      <column caption='Customer life time value' datatype='real' name='[Calculation_1249885854838793]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Sales])*0.2' />
      </column>
      <column caption='Average profit per product' datatype='real' name='[Calculation_1249885855645706]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Profit])' />
      </column>
      <column caption='Product return probability' datatype='string' name='[Calculation_1249885857611787]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Profit] &lt;0 THEN &quot;1&quot;&#13;&#10;ELSE &quot;0&quot;&#13;&#10;END' />
      </column>
      <column caption='Running total sales' datatype='real' name='[Calculation_1249885860048908]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_SUM(SUM([Sales]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Profit per order category' datatype='real' name='[Calculation_1249885860810765]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Profit])/COUNTD([Order ID])' />
      </column>
      <column caption='Oreder quantity' datatype='integer' name='[Calculation_1249885863612431]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Quantity])' />
      </column>
      <column caption='Order returns flag' datatype='string' name='[Calculation_1249885869793296]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Profit] &lt;0 THEN &quot;-1&quot; &#13;&#10;ELSE &quot;1&quot; &#13;&#10;END' />
      </column>
      <column caption='Shipping speed cattegory' datatype='string' name='[Calculation_1374129944674304]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Ship Mode] = &quot;Standard Class&quot; THEN &quot;Fast shipping&quot;&#13;&#10;ELSEIF  [Ship Mode] = &quot;First Class&quot; THEN &quot;Medium shipping&quot;&#13;&#10;ELSE &quot;Slow shipping&quot;&#13;&#10;END' />
      </column>
      <column caption='Customer loyality classification' datatype='string' name='[Calculation_1374129949450242]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF COUNT([Order ID]) &gt;5 THEN &quot;Loyal&quot; ELSE &quot;New&quot; END' />
      </column>
      <column caption='Custom region' datatype='string' name='[Calculation_1374129951109123]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [State] = &quot;Washington,California,Oregon&quot; THEN &quot;West&quot;&#13;&#10;ELSE &quot;Other&quot;&#13;&#10;END' />
      </column>
      <column caption='City population category' datatype='string' name='[Calculation_1374129953443844]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF COUNT([Order ID]) &gt;100 THEN &quot;Urbon&quot;&#13;&#10;ELSE &quot;Small city&quot;&#13;&#10;END' />
      </column>
      <column caption='Two region split' datatype='string' name='[Calculation_1374129958326277]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Region] IN(&quot;East&quot;,&quot;South&quot;) THEN &quot;lower region&quot; ELSE &quot;upper region&quot; END' />
      </column>
      <column caption='  First letter of product name' datatype='string' name='[Calculation_1374129961197574]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='LEFT([Product Name],1)' />
      </column>
      <column caption='Product name length category' datatype='string' name='[Calculation_1374129963397127]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF LEN([Product Name]) &gt;20 THEN &quot;long name&quot; ELSE &quot;short name&quot; END' />
      </column>
      <column caption='Product name alphabet category' datatype='string' name='[Calculation_1374129969553416]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF LEFT([Product Name],1) &lt;&quot;m&quot; then &quot;a-l&quot; else &quot;m-z&quot; end' />
      </column>
      <column caption='Discount category' datatype='string' name='[Calculation_1951098364739589]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Discount]= 0 THEN &quot;no discount&quot; ELSEIF [Discount] &gt;= 0.2 THEN &quot;low discount&quot; ELSE &quot;high discount&quot; END' />
      </column>
      <column datatype='string' name='[City]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
      <column datatype='string' name='[Country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
      <column datatype='string' name='[Region]' role='dimension' type='nominal' />
      <column datatype='integer' name='[Row ID]' role='dimension' type='ordinal' />
      <column datatype='string' name='[Segment]' role='dimension' type='nominal' />
      <column datatype='string' name='[State]' role='dimension' semantic-role='[State].[Name]' type='nominal' />
      <column caption='Sub-Category (group) 1' datatype='string' name='[Sub-Category (group)]' role='dimension' type='nominal'>
        <calculation class='categorical-bin' column='[Sub-Category]' new-bin='true'>
          <bin default-name='true' value='&quot;Appliances, Chairs, Furnishings and 3 more&quot;'>
            <value>&quot;Appliances&quot;</value>
