      <aliases enabled='yes' />
      <column caption='Cgst%' datatype='real' name='[CGST%]' role='measure' type='quantitative' />
      <column caption='Cgst' datatype='real' name='[CGST]' role='measure' type='quantitative' />
      <column caption='RETURN QUANTITY' datatype='real' name='[Calculation_0672681661046784]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Qty])' />
      </column>
      <column caption='UNIT PRICE' datatype='real' name='[Calculation_0672681662537730]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1154817396158464]/[Qty]' />
      </column>
      <column caption='RETURN AMOUNT' datatype='real' name='[Calculation_0672681665855491]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1154817396158464]*[Qty]' />
      </column>
      <column caption='SALES CATEGORY' datatype='string' name='[Calculation_0672681669713924]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([Calculation_1154817396158464]) &gt; 50000 THEN &quot;High Sales&quot;&#13;&#10;ELSEIF SUM([Calculation_1154817396158464]) &gt; 20000 THEN &quot;Medium Sales&quot;&#13;&#10;ELSE &quot;Low Sales&quot;&#13;&#10;END' />
      </column>
      <column caption='ORDER SIZE CATEGORY' datatype='string' name='[Calculation_0672681670049797]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1154817396158464] &gt; 10000 THEN &quot;Large Order&quot;&#13;&#10;ELSEIF [Calculation_1154817396158464] &gt; 5000 THEN &quot;Medium Order&quot;&#13;&#10;ELSE &quot;Small Order&quot;&#13;&#10;END' />
      </column>
      <column caption='TOTAL SALES' datatype='real' name='[Calculation_0672681672638471]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1154817396158464])' />
      </column>
      <column caption='TOTAL QUANTITY' datatype='real' name='[Calculation_0672681672806408]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Qty])' />
      </column>
      <column caption='TOTAL ORDERS' datatype='integer' name='[Calculation_0672681673424905]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([Voucher Number])' />
      </column>
      <column caption='AVERAGE ORDER VALUE' datatype='real' name='[Calculation_0672681673707530]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1154817396158464])/COUNT([Voucher Number])' />
      </column>
      <column caption='SALES PER CUSTOMER' datatype='real' name='[Calculation_0672681674231819]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1154817396158464])/COUNTD([Party])' />
      </column>
      <column caption='SALES PER PRODUCT' datatype='real' name='[Calculation_0672681674489868]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1154817396158464])/COUNT([Product Name])' />
      </column>
      <column caption='QUANTITY PER ORDER' datatype='real' name='[Calculation_0672681675063309]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Qty])/COUNT([Voucher Number])' />
      </column>
      <column caption='RUNNING SALES' datatype='real' name='[Calculation_0672681675436046]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_SUM(SUM([Calculation_1154817396158464]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='SALES GROWTH %' datatype='real' name='[Calculation_0672681675804687]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Calculation_1154817396158464]) - LOOKUP(SUM([Calculation_1154817396158464]), -1)) &#13;&#10;/ LOOKUP(SUM([Calculation_1154817396158464]), -1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='CONTRIBUTION %' datatype='real' name='[Calculation_0672681676083216]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1154817396158464]) / TOTAL(SUM([Calculation_1154817396158464]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='SALES EFFICIENCY' datatype='real' name='[Calculation_0672681676283921]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1154817396158464])/SUM([Qty])' />
      </column>
      <column caption='HIGH VALUE CUSTOMERS' datatype='string' name='[Calculation_0672681676537874]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([Calculation_1154817396158464]) &gt; 30000 THEN &quot;High Value&quot;&#13;&#10;ELSE &quot;Normal&quot;&#13;&#10;END' />
      </column>
      <column caption='PRODUCT DEMAND' datatype='string' name='[Calculation_0672681676746771]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([Qty]) &gt; 30000 THEN &quot;High Value&quot;&#13;&#10;ELSE &quot;Normal&quot;&#13;&#10;END' />
      </column>
      <column caption='NET SALES' datatype='real' name='[Calculation_0672681697554453]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1154817396158464])-SUM([Calculation_0672681665855491])' />
      </column>
      <column caption='GST ' datatype='real' name='[Calculation_0672681698656278]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[CGST]+[SGST]+[IGST]' />
      </column>
      <column caption='GST%' datatype='real' name='[Calculation_0672681698795543]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[CGST%]+[SGST%]+[IGST%]' />
      </column>
      <column caption='TOTAL GST ' datatype='real' name='[Calculation_0672681701924889]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_0672681698656278])' />
      </column>
      <column caption='CUSTOMER LOYALITY' datatype='integer' name='[Calculation_0672681703628826]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Voucher Number])' />
      </column>
      <column caption='SALES AMOUNT' datatype='real' name='[Calculation_1154817396158464]' role='measure' type='quantitative'>
