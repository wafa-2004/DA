      <column caption='Cgst%' datatype='real' name='[CGST%]' role='measure' type='quantitative' />
      <column caption='Cgst' datatype='real' name='[CGST]' role='measure' type='quantitative' />
      <column caption='Return Category' datatype='string' name='[Calculation_1237830149226496]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Qty] = 0 THEN &quot;No Return&quot;&#13;&#10;ELSEIF [Qty] &lt;= 5 THEN &quot;Low Return&quot;&#13;&#10;ELSE &quot;High Return&quot;&#13;&#10;END' />
      </column>
      <column caption='Month Name' datatype='datetime' name='[Calculation_1237830149742593]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='DATETIME([Date])' />
      </column>
      <column caption='SALES AMOUNT' datatype='real' name='[Calculation_1237830151979011]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Qty]*[Total]' />
      </column>
      <column caption='RETURN AMOUNT' datatype='real' name='[Calculation_1237830152519684]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Amount]*[Total]' />
      </column>
      <column caption='NET SALES' datatype='real' name='[Calculation_1237830153170949]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1237830151979011]) - SUM([Calculation_1237830152519684])' />
      </column>
      <column caption='RETURN QUANTITY' datatype='real' name='[Calculation_1237830154338312]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Qty])-SUM([Total])' />
      </column>
      <column caption='RETURN RATE%' datatype='real' name='[Calculation_1237830156505097]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1237830154338312]/SUM([Qty])' />
      </column>
      <column caption='RETURN AMOUNT PER ORDER' datatype='real' name='[Calculation_1237830156951562]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1237830152519684])/COUNT([Voucher Form])' />
      </column>
      <column caption='AVERAGE SALES PER CUSTOMER' datatype='real' name='[Calculation_1237830157381643]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1237830151979011])/COUNT([Party])' />
      </column>
      <column caption='SALES PER PRODUCT' datatype='real' name='[Calculation_1237830157873164]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1237830151979011])/COUNTD([Product Name])' />
      </column>
      <column caption='RETURN LOSS' datatype='real' name='[Calculation_1237830158168077]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1237830152519684])' />
      </column>
      <column caption='RUNNING TOTAL SALES' datatype='real' name='[Calculation_1237830158422030]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_SUM(SUM([Calculation_1237830151979011]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='CONTRIBUTION %' datatype='real' name='[Calculation_1237830158790671]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1237830151979011])/TOTAL(SUM([Calculation_1237830151979011]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='RETURN IMPACT %' datatype='real' name='[Calculation_1237830159548432]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1237830152519684])/SUM([Calculation_1237830151979011])' />
      </column>
      <column caption='ORDER FREQUENCY' datatype='integer' name='[Calculation_1237830159998994]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([Unit])' />
      </column>
      <column caption='Top Products Flag' datatype='string' name='[Calculation_1237830160830483]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF RANK(SUM([Calculation_1237830151979011])) &lt;= 10 THEN &quot;Top 10&quot;&#13;&#10;ELSE &quot;Others&quot;&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Profitability Status' datatype='string' name='[Calculation_1237830161428501]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF (SUM([Calculation_1237830151979011])) - SUM([Calculation_1237830152519684]) &gt; 0 &#13;&#10;THEN &quot;Profit&quot;&#13;&#10;ELSE &quot;Loss&quot;&#13;&#10;END' />
      </column>
      <column caption='RETURN CATEGORY' datatype='string' name='[Calculation_1237830161965078]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1237830154338312] = 0&#13;&#10;THEN &quot;NO RETURN&quot;&#13;&#10;ELSEIF [Calculation_1237830154338312] &lt;= 5&#13;&#10;THEN &quot;LOW RETURN&quot;&#13;&#10;ELSE &quot;HIGH RETURN&quot;&#13;&#10;END' />
      </column>
      <column caption='SALES CATEGORY' datatype='string' name='[Calculation_1237830163009559]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([Calculation_1237830151979011]) &gt; 50000 &#13;&#10;THEN &quot;HIGH SALES&quot;&#13;&#10;ELSEIF SUM([Calculation_1237830151979011]) &gt; 20000&#13;&#10;THEN &quot;MEDIUM SALES&quot;&#13;&#10;ELSE &quot;LOW SALES&quot;&#13;&#10;END' />
      </column>
